<Window x:Class="TickTack.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TickTack"
        xmlns:vm="clr-namespace:TickTack.ViewModels"
        mc:Ignorable="d"
        Title="Крестики-Нолики" Height="480" Width="420"
        WindowStartupLocation="CenterScreen"
        Background="#1e1e2e">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0"
                   Text="{Binding StatusText}"
                   FontSize="22" FontWeight="SemiBold"
                   Foreground="White" HorizontalAlignment="Center"
                   Margin="0,0,0,12"/>
        <ItemsControl Grid.Row="1" ItemsSource="{Binding Cells}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="3" Columns="3"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Content="{Binding Symbol}"
                        Command="{Binding ClickCommand}"
                        IsEnabled="{Binding IsEnabled}"
                        FontSize="56"
                        FontWeight="Bold"
                        Margin="3"
                        BorderThickness="0"
                        Cursor="Hand">
                        <Button.Background>
                            <SolidColorBrush Color="#313244"/>
                        </Button.Background>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Foreground" Value="#89b4fa"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Symbol}" Value="0">
                                        <Setter Property="Foreground" Value="#f38ba8"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button Grid.Row="2"
                Content="Новая Игра"
                Command="{Binding NewGameCommand}"
                Margin="0,12,0,0" Padding="10,8" FontSize="14"
                Background="#89bafa"
                Foreground="#1e1e2e"
                BorderThickness="0" FontWeight="Bold"/>
    </Grid>

</Window>
