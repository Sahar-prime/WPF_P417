<Window x:Class="P417_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:P417_WPF"
        
        xmlns:col="clr-namespace:System.Collections;assembly=mscorlib"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        
        mc:Ignorable="d"
        Title="MainWindow" Height="500" Width="600" FontSize="24">
    <StackPanel>
        <TextBox x:Name="myTextBox" Height="30"/>
        <TextBox x:Name="myTextBlock" 
                   Text="{Binding ElementName=myTextBox,Path=Text,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                   Height="30"/>
        <Button Height="15" Width="30" />
    </StackPanel>
</Window>