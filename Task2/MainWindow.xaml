<Window x:Class="Task2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Task2"
        mc:Ignorable="d"
        Title="Игра Память (Memory Game)" Height="550" Width="450" Background="#F0F2F5">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Панель со статистикой -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,15">
            <TextBlock Text="Ходы: " FontSize="18" FontWeight="Bold" Foreground="#333"/>
            <TextBlock Text="{Binding Moves}" FontSize="18" FontWeight="Bold" Foreground="#007ACC" Width="60"/>

            <TextBlock Text="Время: " FontSize="18" FontWeight="Bold" Foreground="#333" Margin="20,0,0,0"/>
            <TextBlock Text="{Binding TimeDisplay}" FontSize="18" FontWeight="Bold" Foreground="#007ACC" Width="80"/>
        </StackPanel>

        <!-- Игровое поле -->
        <ItemsControl Grid.Row="1" ItemsSource="{Binding Cards}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="4" Rows="4"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <!-- Кнопка-карточка -->
                    <Button Margin="5" Click="Card_Click" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#2D2D30"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontSize" Value="28"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Style.Triggers>
                                    <!-- Если карта открыта или совпала, меняем фон на светлый -->
                                    <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                        <Setter Property="Background" Value="White"/>
                                        <Setter Property="Foreground" Value="#333"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsMatched}" Value="True">
                                        <Setter Property="Background" Value="#E1F5FE"/>
                                        <Setter Property="Foreground" Value="#0288D1"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="{Binding CurrentValue}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Кнопка перезапуска -->
        <Button Grid.Row="2" Content="Новая игра" Height="40" Margin="0,15,0,0" 
                FontSize="16" FontWeight="Bold" Background="#007ACC" Foreground="White"
                Click="Restart_Click"/>
    </Grid>
</Window>